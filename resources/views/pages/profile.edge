@layouts.app({
    user: user
})

@slot('main')
<h1>Profile</h1>

<div style="background:white; padding:20px; border-radius:10px; margin-top:15px; max-width:480px;">

    <div style="margin-bottom:20px;">
        @!avatar({
            initials: user.initials,
            style: 'display:inline-flex; align-items:center; justify-content:center; width:64px; height:64px; border-radius:50%; background:#111827; color:white; font-weight:bold;'
        })
    </div>

    <p><strong>Email:</strong> {{ user.email }}</p>
    <p><strong>Role:</strong> {{ user.role }}</p>

    @form({ route: 'profile.update', method: 'POST' })

        <div>
            @field.root({ name: 'fullName' })
                @!field.label({ text: 'Full name' })
                @!input.control({ type: 'text', value: user.fullName })
                @!field.error()
            @end
        </div>

        <div>
            @!button({ text: 'Save Changes', type: 'submit' })
        </div>

    @end

</div>
@endslot

@end
