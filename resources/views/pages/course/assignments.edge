<body style="margin:0; padding:0;">
@include('partials/header')

<div style="display:flex; width:100vw; min-height:100vh; margin:0; padding:0;">

  @include('partials/sidebar')

  <main style="flex:1; padding:20px;">

    <h1 style="margin-top:0;">Assignments</h1>
    <p>Course ID: {{ courseId }}</p>

    <div style="background:white; border-radius:10px; overflow:hidden;">

      <table style="width:100%; border-collapse:collapse;">

        <thead style="background:#111827; color:white;">
          <tr>
            <th style="text-align:left; padding:12px;">Assignment</th>
            <th style="text-align:left; padding:12px;">Due Date</th>
            <th style="text-align:left; padding:12px;">Submitted</th>
          </tr>
        </thead>

        <tbody>

          @each(a in assignments)

            <tr style="border-bottom:1px solid #eee;">

              <!-- NAME = LINK TO DROPBOX -->
              <td style="padding:12px;">
                <a
                  href="{{ urlFor('submissions.create',{
                    courseId: courseId,
                    assignmentId: a.id
                  }) }}"
                  style="
                    color:#111827;
                    text-decoration:none;
                    font-weight:500;
                  "
                >
                  {{ a.name }}
                </a>
              </td>

              <td style="padding:12px;">
                {{ a.due }}
              </td>

              <!-- SUBMITTED STATUS -->
              <td style="padding: 12px;">
                @if(a.submitted)
                  <span style="color: green; font-weight: bold;">
                    Submitted
                  </span>

                  <br>

                  <a
                    href="{{ urlFor('submissions.file', {
                      courseId: courseId,
                      assignmentId: a.id
                    }) }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    style="
                      color: #2563eb;
                      text-decoration: underline;
                      font-weight: 500;
                    "
                  >
                    View File
                  </a>
                @else
                  <span style="color: red; font-weight: bold;">
                    Not Submitted
                  </span>
                @end
              </td>

            </tr>

          @endeach

        </tbody>

      </table>

    </div>

  </main>

</div>

</body>