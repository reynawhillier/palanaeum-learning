@layouts.app({
    user: user
})

<h1>All Students</h1>

<table style="width:100%; border-collapse:collapse;">

    <thead style="background:#111827; color:white;">
        <tr>
            <th style="text-align:left; padding:12px;">Name</th>
            <th style="text-align:left; padding:12px;">Email</th>
            <th style="text-align:left; padding:12px;">Enrollments</th>
            <th style="text-align:left; padding:12px;"></th>
        </tr>
    </thead>

    <tbody>
        @each(student in students)
            <tr style="border-bottom:1px solid #eee;">
                <td style="padding:12px;">{{ student.first_name }} {{ student.last_name }}</td>
                <td style="padding:12px;">{{ student.email }}</td>
                <td style="padding:12px;">{{ student.enrollmentCount }}</td>
                <td style="padding:12px;">
                    <a href="{{ urlFor('students.show', { id: student.id }) }}">
                        View
                    </a>
                </td>
            </tr>
        @else
            <tr>
                <td colspan="4" style="padding:12px;">No students yet.</td>
            </tr>
        @endeach
    </tbody>

</table>

@end
