@layouts.app({
    user: user,
    course: course
})

  <h1>Performance Report</h1>

  <p>Course ID: {{ courseId }}</p>
  <p>
    @if(user.role === 'professor')
      <a href="{{ route('courses.assignments', { courseId }) }}">Back to Assignments</a>
    @elseif(user.role === 'admin')
      <a href="{{ urlFor('courses.show', { id: courseId }) }}">Back to Course</a>
    @endif
  </p>
  <form method="POST" action="{{ route('reports.performance.generate', { courseId }) }}">
    {{ csrfField() }}
    <button type="submit">Generate Report</button>
  </form>

  @if(report)
    <h2>{{ report.courseCode ?? 'Course' }} Performance Summary</h2>

    <p>
      <a href="{{ route('reports.performance.print', { courseId }) }}" target="_blank">
        Open Print View
      </a>
    </p>
    <p>Course Name: {{ report.courseName ?? 'Unknown course' }}</p>
    <p>Students Enrolled: {{ report.studentCount }}</p>
    <p>Assignments: {{ report.assignmentCount }}</p>
    <p>Submitted Work: {{ report.submittedCount }}</p>
    <p>Missing Work: {{ report.missingCount }}</p>
    <p>
      Class Average:
      @if(report.classAverage)
        {{ report.classAverage }}%
      @else
        No grades yet
      @endif
    </p>
    <p>At-Risk Students: {{ report.atRiskCount }}</p>
    <p>Generated At: {{ report.generatedAt }}</p>

    <h2>Student Progress</h2>

    <table style="width:100%; border-collapse:collapse;">
      <thead>
        <tr>
          <th style="text-align:left; padding:8px;">Student</th>
          <th style="text-align:left; padding:8px;">Email</th>
          <th style="text-align:left; padding:8px;">Submitted</th>
          <th style="text-align:left; padding:8px;">Missing</th>
          <th style="text-align:left; padding:8px;">Average</th>
          <th style="text-align:left; padding:8px;">Status</th>
        </tr>
      </thead>

      <tbody>
        @each(student in report.students)
          <tr>
            <td style="padding:8px;">{{ student.name }}</td>
            <td style="padding:8px;">{{ student.email }}</td>
            <td style="padding:8px;">{{ student.submittedCount }}</td>
            <td style="padding:8px;">{{ student.missingCount }}</td>
            <td style="padding:8px;">
              @if(student.averageScore)
                {{ student.averageScore }}%
              @else
                No grades yet
              @endif
            </td>
            <td style="padding:8px;">{{ student.status }}</td>
          </tr>
        @else
          <tr>
            <td colspan="6" style="padding:8px;">No students found for this course.</td>
          </tr>
        @endeach
      </tbody>
    </table>
  @endif

@end
