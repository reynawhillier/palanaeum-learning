@layouts.app({
    user: user,
    course: course
})


@slot('main')

<div class="dashboard">

    <h1>
        {{ course.code }} - {{ course.name }}
    </h1>

    @if(user.role === 'professor')
        <div class="dashboard-actions">
            <a href="{{ urlFor('courses.students', { id: course.id }) }}">View Classlist</a>

            @form({ route: 'courses.destroy', routeParams: { id: course.id }, method: 'POST' })
                @!button({
                    text: 'Delete Course',
                    type: 'submit',
                    style: 'color:red;',
                    onclick: "return confirm('Delete this course? This cannot be undone.')"
                })
            @end
        </div>
    @endif

</div>

@endslot
@end