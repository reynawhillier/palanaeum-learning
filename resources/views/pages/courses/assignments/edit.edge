@layouts.app({
    user: user
})

@slot('main')

<div class="form-container">
    <h1>Edit Assignment</h1>

    @form({ route: 'assignments.update', routeParams: { courseId: courseId, assignmentId: assignment.id }, method: 'POST' })

        <div>
            @field.root({ name: 'title' })
                @!field.label({ text: 'Assignment Title' })
                @!input.control({ type: 'text', value: assignment.title })
                @!field.error()
            @end
        </div>

        <div>
            @field.root({ name: 'description' })
                @!field.label({ text: 'Description' })
                @!textarea.control({ value: assignment.description })
                @!field.error()
            @end
        </div>

        <div>
            @field.root({ name: 'due_date' })
                @!field.label({ text: 'Due Date' })
                @!input.control({ type: 'date', value: assignment.dueDate })
                @!field.error()
            @end
        </div>

        <div>
            @!button({ text: 'Save Changes', type: 'submit' })
        </div>

    @end

    @form({ route: 'assignments.destroy', routeParams: { courseId: courseId, assignmentId: assignment.id }, method: 'POST' })
        @!button({ text: 'Delete Assignment', type: 'submit', style: 'color:red;' })
    @end

</div>

@endslot
@end
