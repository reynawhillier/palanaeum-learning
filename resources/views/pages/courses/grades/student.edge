@layouts.app({
    user: user,
    course: course
})

@slot('main')

<div class="grades-page">

    <h1 class="page-title">
        {{ course.code }} - My Grades
    </h1>


    <table class="grades-table">

        <thead>
            <tr>
                <th>Assignment</th>
                <th>Due Date</th>
                <th>Grade</th>
                <th>Status</th>
            </tr>
        </thead>


        <tbody>

            @each(row in rows)
                <tr>
                    <td>
                        <a href="{{ urlFor('assignments.show', { courseId: course.id, assignmentId: row.id }) }}">
                            {{ row.title }}
                        </a>
                    </td>
                    <td>{{ row.dueDate }}</td>
                    <td>
                        @if(row.score !== null)
                            {{ row.score }}%
                        @else
                            -
                        @endif
                    </td>
                    <td>{{ row.status }}</td>
                </tr>
            @else
                <tr>
                    <td colspan="4">No assignments in this course yet.</td>
                </tr>
            @endeach

        </tbody>

    </table>

    @if(user.role === 'admin')
        <h2 style="margin-top:24px;">Enroll a Student</h2>

        @if(availableStudents.length === 0)

            <p style="color:#666;">Every student is already enrolled in this course.</p>

        @else

            @form({ route: 'courses.enroll', routeParams: { id: course.id }, method: 'POST' })

                <table style="width:100%; border-collapse:collapse;">
                    <tbody>
                        @each(student in availableStudents)
                            <tr style="border-bottom:1px solid #eee;">
                                <td style="padding:12px;">{{ student.first_name }} {{ student.last_name }}</td>
                                <td style="padding:12px; text-align:right;">
                                    <button
                                        type="submit"
                                        name="student_id"
                                        value="{{ student.student_id }}"
                                    >
                                        Enroll
                                    </button>
                                </td>
                            </tr>
                        @endeach
                    </tbody>
                </table>

            @end

        @endif
    @endif

</div>

@endslot

@end
