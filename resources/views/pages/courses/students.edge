@layouts.app({
    user: user,
    course: course
})

@slot('main')

<div class="classlist-page">

    <h1>{{ course.code }} - Classlist</h1>

    <table style="width:100%; border-collapse:collapse;">
        <thead style="background:#111827; color:white;">
            <tr>
                <th style="text-align:left; padding:12px;">Student</th>
                <th style="text-align:left; padding:12px;">Email</th>
                <th style="text-align:left; padding:12px;">Status</th>
            </tr>
        </thead>
        <tbody>
            @each(student in students)
                <tr style="border-bottom:1px solid #eee;">
                    <td style="padding:12px;">{{ student.first_name }} {{ student.last_name }}</td>
                    <td style="padding:12px;">{{ student.email }}</td>
                    <td style="padding:12px;">{{ student.enrollment_status }}</td>
                </tr>
            @else
                <tr>
                    <td colspan="3" style="padding:12px;">No students enrolled in this course.</td>
                </tr>
            @endeach
        </tbody>
    </table>

    @if(user.role === 'admin')
        <h2 style="margin-top:24px;">Enroll a Student</h2>

        @form({ route: 'courses.enroll', routeParams: { id: course.id }, method: 'POST' })

            <div>
                @field.root({ name: 'student_id' })
                    @!field.label({ text: 'Student' })
                    @!select.control({
                        options: availableStudents.map((s) => ({
                            value: s.student_id,
                            name: s.first_name + ' ' + s.last_name
                        }))
                    })
                    @!field.error()
                @end
            </div>

            <div>
                @!button({ text: 'Enroll', type: 'submit' })
            </div>

        @end
    @endif

</div>

@endslot
@end
